#!/usr/bin/env bash
set -euo pipefail

TMUX_BIN="$(command -v tmux || true)"
SESH_BIN="$(command -v sesh || true)"
FZF_BIN="$(command -v fzf || true)"
SCRIPT_PATH="/Users/ab/.local/bin/tmux-session-picker"

if [[ -z "$TMUX_BIN" ]]; then
  echo "tmux not found"
  read -r -p "Press Enter to close..." _
  exit 1
fi

if [[ -z "$SESH_BIN" ]]; then
  echo "sesh not found"
  read -r -p "Press Enter to close..." _
  exit 1
fi

if [[ -z "$FZF_BIN" ]]; then
  echo "fzf not found"
  read -r -p "Press Enter to close..." _
  exit 1
fi

# AeroSpace runs commands without an interactive TTY.
# Reuse an existing tmux client via popup when possible; otherwise launch Ghostty.
if [[ ! -t 0 || ! -t 1 ]]; then
  client_tty="$($TMUX_BIN list-clients -F '#{client_tty}' 2>/dev/null | head -n1 || true)"

  if [[ -n "$client_tty" ]]; then
    if "$TMUX_BIN" display-popup -t "$client_tty" -w 40% -h 70% -E "$SCRIPT_PATH" 2>/dev/null; then
      exit 0
    fi
  fi

  exec open -na Ghostty.app --args --command="$SCRIPT_PATH"
fi

choice="$(
  $SESH_BIN list -t | "$FZF_BIN" \
    --ansi \
    --prompt='Sessions > ' \
    --height=100% \
    --margin=0,0 \
    --padding=1,2 \
    --layout=reverse \
    --border=none \
    --info=inline \
    --bind 'ctrl-j:down,ctrl-k:up,ctrl-n:down,ctrl-p:up,alt-j:down,alt-k:up' \
    --bind "ctrl-s:change-prompt(Sessions > )+reload($SESH_BIN list -t)" \
    --bind "ctrl-f:change-prompt(Create session from zoxide > )+reload($SESH_BIN list -z -d)" \
    --bind "ctrl-x:execute-silent(sh -c 's=\"{}\"; [ -n \"\$s\" ] && $TMUX_BIN kill-session -t \"\$s\"')+reload($SESH_BIN list -t)" ||
    true
)"

[[ -n "$choice" ]] || exit 0

exec "$SESH_BIN" connect "$choice"
